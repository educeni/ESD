#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <math.h>
#include <float.h>

#define MAX_PESSOAS 30
#define QTD_PREF 6
#define TAM_NOME 50


/* ======================================================
   PROTÓTIPOS DAS FUNÇÕES
   ====================================================== */

int cadastro(int qtdCadastro, char **nomes, float **notas, int *quant);
void exibir(char **nomes, float **notas, int qtdCadastro);
int buscarnome(char nomepesquisado[], char **nomes, int qtdCadastro);
float calculaDistancia(float **notas, int pessoa1, int pessoa2, int col);
void afinidade(char **nomes, float **notas, char nomepesquisado[], int qtdCadastro);
float Pessoamaissemelhante(float **notas, int verificaNome, char **nomes, int quant, int *nomeachado);
void analisePreferencia(float **notas, char **nomes, int pessoa1, int pessoa2, int col);
float buscaNota(float **notas, int indiceNota, int pessoa);


/* ======================================================
   FUNÇÃO PRINCIPAL - MAIN
   ====================================================== */

int main()
{
    char **nomes;
    float **notas;
    float result;
    int escolha = -1;
    int qtdCadastro;
    int quant = 0;
    int verificaNome;
    int verificaNome2;
    int nomeachado;
    char nomepesquisado[TAM_NOME];
    char nomepesquisado2[TAM_NOME];
    int i;


    /* ----- Alocação dinâmica dos nomes ----- */
    nomes = malloc(MAX_PESSOAS * sizeof(char *));
    

    for (i = 0; i < MAX_PESSOAS; i++)
    {
        nomes[i] = malloc(TAM_NOME * sizeof(char));
    
    }


    /* ----- Alocação dinâmica das notas ----- */
    notas = malloc(MAX_PESSOAS * sizeof(float *));
    

    for (i = 0; i < MAX_PESSOAS; i++)
    {
        notas[i] = malloc(QTD_PREF * sizeof(float));
    }


    /* ----- Menu principal ----- */
    while (escolha != 0)
    {
        printf("\n========================================\n");
        printf("\tSistema de Afinidades\n");
        printf("========================================\n");
        printf("1 - Cadastrar pessoas\n");
        printf("2 - Exibir pessoas e preferencias\n");
        printf("3 - Buscar pessoa pelo nome\n");
        printf("4 - Comparar duas pessoas\n");
        printf("5 - Encontrar pessoa mais semelhante\n");
        printf("6 - Exibir ranking de afinidade\n");
        printf("7 - Analisar preferencia\n");
        printf("0 - Encerrar\n");
        printf("Opcao: ");
        scanf("%d", &escolha);

        switch (escolha)
        {
            case 1:
                printf("Quantas pessoas deseja cadastrar: ");
                scanf("%d", &qtdCadastro);

                if (qtdCadastro <= 0)
                {
                    printf("Informe uma quantidade maior que zero.\n");
                }
                else if (quant + qtdCadastro > MAX_PESSOAS)
                {
                    printf("Quantidade excede o limite do sistema.\n");
                    printf("Vagas restantes: %d\n", MAX_PESSOAS - quant);
                }
                else
                {
                    cadastro(qtdCadastro, nomes, notas, &quant);
                    printf("\nCadastro realizado com sucesso!\n");
                }
                break;


            case 2:
                if (quant > 0)
                {
                    exibir(nomes, notas, quant);
                }
                else
                {
                    printf("Nenhum cadastro registrado ainda.\n");
                }
                break;


            case 3:
                if (quant > 0)
                {
                    printf("Me diga um nome: ");
                    scanf("%49s", nomepesquisado);

                    verificaNome = buscarnome(nomepesquisado, nomes, quant);

                    if (verificaNome != -1)
                    {
                        printf("%s foi encontrado no sistema.\n", nomepesquisado);
                    }
                    else
                    {
                        printf("Usuario nao encontrado.\n");
                    }
                }
                else
                {
                    printf("Nenhum cadastro registrado ainda.\n");
                }
                break;


            case 4:
                if (quant < 2)
                {
                    printf("E necessario cadastrar pelo menos duas pessoas.\n");
                    break;
                }

                printf("Forneca o nome da primeira pessoa: ");
                scanf("%49s", nomepesquisado);
                printf("Forneca o nome da segunda pessoa: ");
                scanf("%49s", nomepesquisado2);

                verificaNome = buscarnome(nomepesquisado, nomes, quant);
                verificaNome2 = buscarnome(nomepesquisado2, nomes, quant);

                if (verificaNome != -1 && verificaNome2 != -1)
                {
                    result = calculaDistancia(notas, verificaNome, verificaNome2, QTD_PREF);

                    printf("\n========================================\n");
                    printf("COMPARACAO DE PERFIS\n");
                    printf("========================================\n");
                    printf("%s x %s\n", nomes[verificaNome], nomes[verificaNome2]);
                    printf("Distancia euclidiana: %.2f\n", result);
                }
                else
                {
                    printf("Um ou mais nomes nao foram encontrados.\n");
                }
                break;


            case 5:
                if (quant < 2)
                {
                    printf("E necessario cadastrar pelo menos duas pessoas.\n");
                    break;
                }

                printf("Forneca o nome da pessoa: ");
                scanf("%49s", nomepesquisado);

                verificaNome = buscarnome(nomepesquisado, nomes, quant);

                if (verificaNome != -1)
                {
                    result = Pessoamaissemelhante(notas, verificaNome, nomes, quant, &nomeachado);

                    printf("\n========================================\n");
                    printf("PESSOA MAIS SEMELHANTE\n");
                    printf("========================================\n");
                    printf("A pessoa mais proxima de %s e %s\n", nomes[verificaNome], nomes[nomeachado]);
                    printf("Distancia: %.2f\n", result);
                }
                else
                {
                    printf("Nome nao encontrado.\n");
                }
                break;


            case 6:
                if (quant < 2)
                {
                    printf("E necessario cadastrar pelo menos duas pessoas.\n");
                    break;
                }

                printf("Informe a pessoa de referencia: ");
                scanf("%49s", nomepesquisado);

                afinidade(nomes, notas, nomepesquisado, quant);
                break;


            case 7:
                if (quant < 2)
                {
                    printf("E necessario cadastrar pelo menos duas pessoas.\n");
                    break;
                }

                printf("Informe a primeira pessoa: ");
                scanf("%49s", nomepesquisado);
                printf("Informe a segunda pessoa: ");
                scanf("%49s", nomepesquisado2);

                verificaNome = buscarnome(nomepesquisado, nomes, quant);
                verificaNome2 = buscarnome(nomepesquisado2, nomes, quant);

                if (verificaNome != -1 && verificaNome2 != -1)
                {
                    analisePreferencia(notas, nomes, verificaNome, verificaNome2, QTD_PREF);
                }
                else
                {
                    printf("Um ou mais nomes nao foram encontrados.\n");
                }
                break;


            case 0:
                printf("\nEncerrando o sistema...\n");
                break;


            default:
                printf("Opcao invalida. Tente novamente.\n");
                break;
        }
    }


    /* ----- Liberação da memória ----- */
    for (i = 0; i < MAX_PESSOAS; i++)
    {
        free(notas[i]);
    }
    free(notas);

    for (i = 0; i < MAX_PESSOAS; i++)
    {
        free(nomes[i]);
    }
    free(nomes);

    return 0;
}


/* ======================================================
   FUNÇÃO 1 - CADASTRO
   ====================================================== */

int cadastro(int qtdCadastro, char **nomes, float **notas, int *quant)
{
    int i, k;
    float nota;
    char *categorias[] = {"Musica", "Cinema", "Jogos", "Esportes", "Leitura", "Programacao"};

    for (i = 0; i < qtdCadastro; i++)
    {
        printf("\nForneca o nome: ");
        scanf("%49s", nomes[*quant]);

        for (k = 0; k < QTD_PREF; k++)
        {
            do
            {
                printf("Nota para %s: ", categorias[k]);
                scanf("%f", &nota);

                if (nota < 0 || nota > 10)
                {
                    printf("Nota invalida! Deve ser entre 0 e 10.\n");
                }
            }
            while (nota < 0 || nota > 10);

            notas[*quant][k] = nota;
        }

        (*quant)++;
    }

    return 1;
}


/* ======================================================
   FUNÇÃO 2 - EXIBIR PESSOAS
   ====================================================== */

void exibir(char **nomes, float **notas, int qtdCadastro)
{
    int i;

    printf("\n========================================\n");
    printf("PREFERENCIAS CADASTRADAS\n");
    printf("========================================\n");

    for (i = 0; i < qtdCadastro; i++)
    {
        printf("\nPessoa %d\n", i + 1);
        printf("Nome: %s\n", nomes[i]);
        printf("Musica: %.1f\n", notas[i][0]);
        printf("Cinema: %.1f\n", notas[i][1]);
        printf("Jogos: %.1f\n", notas[i][2]);
        printf("Esportes: %.1f\n", notas[i][3]);
        printf("Leitura: %.1f\n", notas[i][4]);
        printf("Programacao: %.1f\n", notas[i][5]);
        printf("----------------------------------------\n");
    }
}


/* ======================================================
   FUNÇÃO 3 - BUSCAR NOME
   ====================================================== */

int buscarnome(char nomepesquisado[], char **nomes, int qtdCadastro)
{
    int i;

    for (i = 0; i < qtdCadastro; i++)
    {
        if (strcmp(nomepesquisado, nomes[i]) == 0)
        {
            return i;
        }
    }

    return -1;
}


/* ======================================================
   FUNÇÃO 4 - CALCULAR DISTÂNCIA
   ====================================================== */

float calculaDistancia(float **notas, int pessoa1, int pessoa2, int col)
{
    int j;
    float soma = 0;
    float diferenca;

    for (j = 0; j < col; j++)
    {
        diferenca = notas[pessoa1][j] - notas[pessoa2][j];
        soma += diferenca * diferenca;
    }

    return sqrt(soma);
}


/* ======================================================
   FUNÇÃO 5 - PESSOA MAIS SEMELHANTE
   ====================================================== */

float Pessoamaissemelhante(float **notas, int verificaNome, char **nomes, int quant, int *nomeachado)
{
    int i;
    float result;
    float proximo = FLT_MAX;

    for (i = 0; i < quant; i++)
    {
        if (verificaNome != i)
        {
            result = calculaDistancia(notas, verificaNome, i, QTD_PREF);

            printf("Distancia para %s: %.2f\n", nomes[i], result);

            if (result < proximo)
            {
                *nomeachado = i;
                proximo = result;
            }
        }
    }

    return proximo;
}


/* ======================================================
   FUNÇÃO 6 - RANKING DE AFINIDADE
   ====================================================== */

void afinidade(char **nomes, float **notas, char nomepesquisado[], int qtdCadastro)
{
    int *indices;
    float *distancias;
    int i, j;
    int result;
    int qtd = 0;
    int temp_indice;
    float temp_distancia;
    float distancia;

    result = buscarnome(nomepesquisado, nomes, qtdCadastro);

    if (result == -1)
    {
        printf("Nome nao encontrado!\n");
        return;
    }

    /* ----- Alocação dinâmica auxiliar ----- */
    indices = malloc((qtdCadastro - 1) * sizeof(int));
    distancias = malloc((qtdCadastro - 1) * sizeof(float));

    if (indices == NULL || distancias == NULL)
    {
        printf("Erro ao alocar memoria.\n");
        free(indices);
        free(distancias);
        return;
    }

    for (i = 0; i < qtdCadastro; i++)
    {
        if (i != result)
        {
            distancia = calculaDistancia(notas, result, i, QTD_PREF);
            distancias[qtd] = distancia;
            indices[qtd] = i;
            qtd++;
        }
    }

    /* ----- Bubble Sort ----- */
    for (i = 0; i < qtd - 1; i++)
    {
        for (j = 0; j < qtd - 1 - i; j++)
        {
            if (distancias[j] > distancias[j + 1])
            {
                temp_distancia = distancias[j];
                distancias[j] = distancias[j + 1];
                distancias[j + 1] = temp_distancia;

                temp_indice = indices[j];
                indices[j] = indices[j + 1];
                indices[j + 1] = temp_indice;
            }
        }
    }

    printf("\n========================================\n");
    printf("PERFIS MAIS PROXIMOS DE %s\n", nomes[result]);
    printf("========================================\n");

    for (i = 0; i < qtd; i++)
    {
        printf("%d - %s - Distancia: %.2f\n", i + 1, nomes[indices[i]], distancias[i]);
    }

    /* ----- Liberando memória ----- */
    free(indices);
    free(distancias);
}


/* ======================================================
   FUNÇÃO 7 - BUSCAR NOTA
   ====================================================== */

float buscaNota(float **notas, int indiceNota, int pessoa)
{
    return notas[pessoa][indiceNota];
}


/* ======================================================
   FUNÇÃO 8 - ANÁLISE DE PREFERÊNCIA
   ====================================================== */

void analisePreferencia(float **notas, char **nomes, int pessoa1, int pessoa2, int col)
{
    float nota, nota2;
    float diferenca[QTD_PREF];
    float menorDif = FLT_MAX;
    float distancia;
    int i;
    char *categorias[] = {"Musica", "Cinema", "Jogos", "Esportes", "Leitura", "Programacao"};

    distancia = calculaDistancia(notas, pessoa1, pessoa2, col);

    printf("\n===============================================\n");
    printf("ANALISE DE PERFIS\n");
    printf("===============================================\n\n");
    printf("%s x %s\n\n", nomes[pessoa1], nomes[pessoa2]);
    printf("Preferencia\t%s\t%s\tDiferenca\n", nomes[pessoa1], nomes[pessoa2]);
    printf("-------------------------------------------------\n");

    for (i = 0; i < col; i++)
    {
        nota = buscaNota(notas, i, pessoa1);
        nota2 = buscaNota(notas, i, pessoa2);

        diferenca[i] = fabs(nota - nota2);

        if (diferenca[i] < menorDif)
        {
            menorDif = diferenca[i];
        }

        printf("%-15s %.1f\t%.1f\t%.1f\n", categorias[i], nota, nota2, diferenca[i]);
    }

    printf("-------------------------------------------------\n");
    printf("Distancia euclidiana: %.2f\n\n", distancia);
    printf("Preferencias mais semelhantes:\n");

    for (i = 0; i < col; i++)
    {
        if (diferenca[i] == menorDif)
        {
            printf("- %s\n", categorias[i]);
        }
    }
}
